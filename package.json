{
  "name": "sovereign-sigma-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:moltworker": "wrangler deploy -c wrangler.moltworker.toml",
    "proto:compile": "node scripts/compile-protos.mjs",
    "test:engine": "vitest run",
    "tune:parameters": "tsx scripts/tune_parameters.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:typecheck": "npm run typecheck --prefix web"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ethers": "^6.16.0",
    "protobufjs": "^8.3.0"
  }
}
