{
  "name": "sovereign-sigma-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:moltworker": "wrangler deploy -c wrangler.moltworker.toml",
    "format": "prettier --write src/execution src/engine src/strategy tests/engine eslint.config.mjs vitest.config.ts",
    "format:check": "prettier --check src/execution src/engine src/strategy tests/engine eslint.config.mjs vitest.config.ts",
    "lint": "eslint src/execution src/engine src/strategy tests/engine",
    "moltworker:local": "node scripts/moltworker_supervisor_loop.mjs",
    "moltworker:once": "MOLTWORKER_ONCE=true node scripts/moltworker_supervisor_loop.mjs",
    "proto:compile": "node scripts/compile-protos.mjs",
    "test:engine": "vitest run --coverage",
    "tune:parameters": "tsx scripts/tune_parameters.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:typecheck": "npm run typecheck --prefix web"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.22.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ethers": "^6.16.0",
    "hono": "^4.12.19",
    "protobufjs": "^8.3.0"
  }
}
